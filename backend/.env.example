DATABASE_URL=jdbc:postgresql://localhost:5432/caterflow_api
# If Flyway says "non-empty schema but no schema history table", your Docker
# volume has a stale DB. Either use caterflow_api (above) or reset: docker compose down -v
DATABASE_USER=caterflow
DATABASE_PASSWORD=dev_password
# Generate: openssl rand -hex 32
JWT_SECRET=change-me-to-a-string-of-at-least-32-characters
JWT_ACCESS_EXPIRY=900000
JWT_REFRESH_EXPIRY=604800000
# Comma-separated; patterns allowed (e.g. https://*.vercel.app for Vercel previews)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
MAIL_HOST=localhost
MAIL_PORT=1025
SPRING_PROFILES_ACTIVE=dev

# AI search (backend-only — never expose to frontend)
AI_PROVIDER=heuristic
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Cloudflare R2 (S3-compatible) — required for logo/gallery/package/document uploads.
# Uploads go through POST /api/media/upload (server writes to R2); bucket CORS is optional.
# Endpoint = account API host ONLY (no /bucket path). Bucket is separate.
# R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# R2_ACCESS_KEY=
# R2_SECRET_KEY=
# R2_BUCKET=caterflow-media
# Public URL base (r2.dev or custom domain). Trailing slash optional.
# R2_PUBLIC_BASE_URL=https://pub-<hash>.r2.dev
